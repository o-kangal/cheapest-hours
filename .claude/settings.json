{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Edit(TASKS.md)",
      "Edit(docs/**)",
      "Edit(README.md)",
      "Edit(CHANGELOG.md)",
      "Edit(.gitignore)",
      "Bash(pnpm *)",
      "Bash(npm view *)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(public/**)",
      "Edit(package.json)",
      "Edit(tsconfig.json)",
      "Edit(vite.config.ts)",
      "Edit(vitest.config.ts)",
      "Edit(eslint.config.js)",
      "Edit(functions/**)",
      "Edit(index.html)"
    ],
    "deny": [
      "Edit(AGENTS.md)",
      "Edit(.dev-kit.json)",
