{
  "name": "cheapest-hours",
  "version": "0.1.0",
  "private": true,
  "description": "Shows Germany's day-ahead electricity prices and the cheapest time window to run a flexible load.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "vite build && wrangler pages dev dist",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261127.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
